{
  "name": "jsoneo",
  "version": "1.1.0",
  "description": "A powerful JSON enhancement library that supports all JSON primitives, Date, RegExp, Symbol, Functions, Map, Set, TypedArray and much more! Almost everything in JavaScript.",
  "keywords": [
    "JSON",
    "Serialization",
    "Deserialization",
    "stringify",
    "parse",
    "e2e"
  ],
  "homepage": "https://github.com/shijistar/jsoneo",
  "bugs": {
    "url": "https://github.com/shijistar/jsoneo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shijistar/jsoneo.git"
  },
  "license": "MIT",
  "author": "李凤宝(Leo) <shijistar@gmail.com>",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "es",
    "umd",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:es": "run-s gv task:build-es task:add-es-extensions task:add-umd-banner",
    "build:lib": "run-s gv ts2lib task:copy-lib",
    "build:tses": "run-s gv ts2es task:add-tses-extensions",
    "build-storybook": "run-s task:update-docs-title task:update-stories-title task:build-storybook",
    "clean": "shx rm -rf lib es es-legacy umd tses tslib",
    "codegraph-init": "node scripts/prepare-codegraph.js",
    "gv": "node scripts/generate-version.js",
    "init-husky": "husky",
    "prepare": "run-s gv init-husky codegraph-init task:update-docs-title task:update-stories-title",
    "prepublishOnly": "run-s build test",
    "storybook": "run-s task:update-docs-title task:update-stories-title task:storybook",
    "task:add-es-extensions": "tsx scripts/add-esm-extensions.ts es",
    "task:add-tses-extensions": "tsx scripts/add-esm-extensions.ts tses",
    "task:add-umd-banner": "tsx scripts/add-umd-banner.ts",
    "task:build-es": "father build",
    "task:build-storybook": "storybook build",
    "task:bundle-e2e": "tsx scripts/make-e2e-bundle.ts",
    "task:copy-lib": "tsx scripts/copy-lib.ts",
    "task:storybook": "storybook dev -p 6006",
    "task:update-docs-title": "tsx scripts/update-docs-title.ts",
    "task:update-stories-title": "tsx scripts/update-stories-title.ts",
    "test": "run-s gv test:node test:install test:browser",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:debug": "cross-env DEBUG=1 vitest run --config vitest.browser.config.ts -w",
    "test:coverage": "vitest run --config vitest.node.config.ts --coverage",
    "test:install": "playwright install",
    "test:node": "vitest run --config vitest.node.config.ts --coverage",
    "test:ui": "vitest --ui",
    "ts2es": "tsc -p tsconfig.es.json",
    "ts2lib": "tsc -p tsconfig.lib.json"
  },
  "overrides": {
    "@umijs/babel-preset-umi": {
      "@babel/runtime": "^7.29.7"
    }
  },
  "devDependencies": {
    "@storybook/addon-docs": "~10.3.5",
    "@storybook/addon-links": "~10.3.5",
    "@storybook/react-vite": "~10.3.5",
    "@tiny-codes/code-style-all-in-one": "^2.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "antd": "^6.6.2",
    "cross-env": "^10.0.0",
    "father": "^4.6.31",
    "glob": "^13.0.6",
    "i18next": "^25.10.10",
    "npm-run-all2": "^9.0.2",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-syntax-highlighter": "^16.1.1",
    "shx": "^0.4.0",
    "storybook": "~10.3.6",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=12"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
